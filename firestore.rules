rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // User data - users can only access their own data
    match /users/{userId} {
      // Allow users to read and write only their own user document
      allow read, write: if isOwner(userId);
      
      // Rosters collection - contains all rosters for this user
      match /rosters/{rosterName} {
        // Allow users to manage their own rosters
        allow read, write: if isOwner(userId);
        
        // Employees sub-collection - contains employees for each roster
        match /employees/{employeeId} {
          // Allow users to manage employees in their own rosters
          allow read, write: if isOwner(userId);
        }
      }
      
      // Settings collection - user preferences and app settings
      match /settings/{settingKey} {
        // Allow users to manage their own settings
        allow read, write: if isOwner(userId);
      }
      
      // Trash collection - deleted rosters that can be restored
      match /trash/{trashItemId} {
        // Allow users to manage their own trash items
        allow read, write: if isOwner(userId);
      }
    }
    
    // Deny access to everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
